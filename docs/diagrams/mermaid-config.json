{
  "theme": "base",
  "look": "classic",
  "layout": "elk",
  "markdownAutoWrap": false,
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "18px",
    "lineColor": "#455A64",
    "textColor": "#263238",
    "edgeLabelBackground": "#FFFFFF",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#90A4AE"
