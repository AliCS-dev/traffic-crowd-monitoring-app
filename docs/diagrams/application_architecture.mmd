    postgres -.->|"Store database files"| pgdata
    backend ==>|"CUDA device access"| gpu

    key["KEY<br/>Blue: client; amber: proxy; teal: API<br/>Grey: data; rose: hardware<br/>Solid arrow: network request<br/>Dashed arrow: storage access<br/>Thick arrow: hardware access<br/>Rectangles: applications/resources<br/>Cylinders: stores; groups: boundaries"]
