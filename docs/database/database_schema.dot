digraph database_schema {
  graph [
    rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.55, ranksep=0.75,
    splines=polyline, outputorder=edgesfirst, fontname="DejaVu Sans",
    fontsize=22, labelloc=t, labeljust=l,
    label="Traffic and Crowd Monitoring\nDatabase relationships | migrations 001-008"
  ];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#52646C",
        fontcolor="#35464E", arrowsize=0.7];

  monitoring_sessions [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#28776F">
      <TR><TD BGCOLOR="#DCEFEA"><B>monitoring_sessions</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">session_name, status</TD></TR>
      <TR><TD ALIGN="LEFT">started_at, completed_at</TD></TR>
    </TABLE>
  >];
  input_sources [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#28776F">
      <TR><TD BGCOLOR="#DCEFEA"><B>input_sources</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  session_id</TD></TR>
      <TR><TD ALIGN="LEFT">source_type, original_filename</TD></TR>
      <TR><TD ALIGN="LEFT">file_path</TD></TR>
    </TABLE>
  >];
  processed_frames [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#28776F">
      <TR><TD BGCOLOR="#DCEFEA"><B>processed_frames</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  session_id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  input_source_id</TD></TR>
      <TR><TD ALIGN="LEFT">frame_number, frame_timestamp_seconds</TD></TR>
      <TR><TD ALIGN="LEFT">image_width, image_height</TD></TR>
      <TR><TD ALIGN="LEFT">output_asset_id, output_file_path</TD></TR>
    </TABLE>
  >];
  model_run_profiles [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52718B">
      <TR><TD BGCOLOR="#E5EDF5"><B>model_run_profiles</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK / FK  session_id</TD></TR>
      <TR><TD ALIGN="LEFT">profile_id, model_id</TD></TR>
      <TR><TD ALIGN="LEFT">checkpoint_sha256, quality_gate_status</TD></TR>
      <TR><TD ALIGN="LEFT">class_mapping, runtime_provenance</TD></TR>
    </TABLE>
  >];
  dense_crowd_analysis_results [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#A77922">
      <TR><TD BGCOLOR="#FBF0D2"><B>dense_crowd_analysis_results</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK / FK  session_id</TD></TR>
      <TR><TD ALIGN="LEFT">status, crowd_count</TD></TR>
      <TR><TD ALIGN="LEFT">method_id, model_id, reason_code</TD></TR>
      <TR><TD ALIGN="LEFT">quality_gate_status, evaluation_reference</TD></TR>
    </TABLE>
  >];
  video_analysis_jobs [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52718B">
      <TR><TD BGCOLOR="#E5EDF5"><B>video_analysis_jobs</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK / FK  session_id</TD></TR>
      <TR><TD ALIGN="LEFT">FK / UQ  input_source_id</TD></TR>
      <TR><TD ALIGN="LEFT">status, sampling_interval_seconds</TD></TR>
      <TR><TD ALIGN="LEFT">sampled_frames_total</TD></TR>
      <TR><TD ALIGN="LEFT">sampled_frames_processed, failure_code</TD></TR>
    </TABLE>
  >];
  detection_results [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#28776F">
      <TR><TD BGCOLOR="#DCEFEA"><B>detection_results</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  processed_frame_id</TD></TR>
      <TR><TD ALIGN="LEFT">object_class, confidence</TD></TR>
      <TR><TD ALIGN="LEFT">bbox_x_min, bbox_y_min</TD></TR>
      <TR><TD ALIGN="LEFT">bbox_x_max, bbox_y_max</TD></TR>
    </TABLE>
  >];
  grid_cells [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#28776F">
      <TR><TD BGCOLOR="#DCEFEA"><B>grid_cells</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  processed_frame_id</TD></TR>
      <TR><TD ALIGN="LEFT">row_index, column_index</TD></TR>
      <TR><TD ALIGN="LEFT">x_min, y_min, x_max, y_max</TD></TR>
    </TABLE>
  >];
  object_count_summaries [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#28776F">
      <TR><TD BGCOLOR="#DCEFEA"><B>object_count_summaries</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  processed_frame_id</TD></TR>
      <TR><TD ALIGN="LEFT">FK?  grid_cell_id</TD></TR>
      <TR><TD ALIGN="LEFT">object_class, object_count</TD></TR>
    </TABLE>
  >];
  alerts [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#A77922">
      <TR><TD BGCOLOR="#FBF0D2"><B>alerts</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  id</TD></TR>
      <TR><TD ALIGN="LEFT">FK  processed_frame_id</TD></TR>
      <TR><TD ALIGN="LEFT">FK?  grid_cell_id</TD></TR>
      <TR><TD ALIGN="LEFT">alert_type, severity, scope</TD></TR>
      <TR><TD ALIGN="LEFT">object_class, measured_value</TD></TR>
      <TR><TD ALIGN="LEFT">threshold_value, comparison_operator</TD></TR>
    </TABLE>
  >];
  schema_migrations [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#899398">
      <TR><TD BGCOLOR="#EDF0F1"><B>schema_migrations</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK  version</TD></TR>
      <TR><TD ALIGN="LEFT">name, checksum, applied_at</TD></TR>
      <TR><TD ALIGN="LEFT"><I>Migration history; no foreign keys</I></TD></TR>
    </TABLE>
  >];

  // Edges point from the referenced table to the table holding the foreign key.
  monitoring_sessions -> input_sources [label="1 : 0..*", weight=5];
  monitoring_sessions -> processed_frames [label="1 : 0..*", constraint=false];
  monitoring_sessions -> model_run_profiles [label="1 : 0..1"];
  monitoring_sessions -> dense_crowd_analysis_results [label="1 : 0..1"];
  monitoring_sessions -> video_analysis_jobs [label="1 : 0..1"];
  input_sources -> processed_frames [label="1 : 0..*", weight=5];
  input_sources -> video_analysis_jobs [label="1 : 0..1"];
  processed_frames -> detection_results [label="1 : 0..*"];
  processed_frames -> grid_cells [label="1 : 0..*", weight=5];
  processed_frames -> object_count_summaries [label="1 : 0..*"];
  processed_frames -> alerts [label="1 : 0..*"];
  grid_cells -> object_count_summaries [label="0..1 : 0..*", style=dashed];
  grid_cells -> alerts [label="0..1 : 0..*", style=dashed];

  { rank=same; model_run_profiles; input_sources; dense_crowd_analysis_results; }
  { rank=same; video_analysis_jobs; processed_frames; }
  { rank=same; detection_results; grid_cells; }
  { rank=same; object_count_summaries; alerts; }
  { rank=same; monitoring_sessions; schema_migrations; }

  legend [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD ALIGN="LEFT"><B>Reading the diagram</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK = primary key   FK = foreign key   FK? = nullable foreign key   UQ = unique</TD></TR>
      <TR><TD ALIGN="LEFT">Arrows: parent to child. Labels: parent count : child count. * = many.</TD></TR>
      <TR><TD ALIGN="LEFT">1 : 0..* means each child has one parent; a parent can have no children or many.</TD></TR>
      <TR><TD ALIGN="LEFT">Dashed links are optional: a count or alert may have no grid-cell reference.</TD></TR>
      <TR><TD ALIGN="LEFT">Selected fields only. Every table and foreign-key relationship is shown.</TD></TR>
    </TABLE>
  >];
  alerts -> legend [style=invis];
  object_count_summaries -> legend [style=invis];
}
