{
  "schema_version": 1,
  "run_name": "yolo26n-validation-selected-baseline",
  "protocol_version": "1.0",
  "random_seed": 2026,
  "dataset": {
    "version": "1.0-draft",
    "role": "validation",
    "manifest_path": "data/evaluation/manifest.csv"
  },
  "model": {
    "name": "Ultralytics YOLO26n COCO baseline",
    "task": "detection",
    "weights_path": "models/yolo26n.pt",
    "source_url": "https://docs.ultralytics.com/models/yolo26/",
    "license_id": "AGPL-3.0",
    "license_url": "https://www.ultralytics.com/legal/agpl-3-0-software-license",
    "class_mapping": {
      "person": "person",
      "bicycle": "bicycle",
      "motorcycle": "motorcycle",
      "car": "car_or_van",
      "bus": "bus",
      "truck": "truck"
    }
  },
  "inference": {
    "confidence_floor": 0.001,
    "operating_confidence": 0.25,
    "image_size": 1280,
    "scale_factor": 2,
    "device": "cuda:0",
    "max_detections": 300,
    "batch_size": 1,
    "numeric_precision": "float32"
  },
  "metrics": {
    "operating_iou": 0.5,
    "low_support_threshold": 20
  },
  "timing": {
    "warmup_frames": 20,
    "measured_frames": 100,
    "repetitions": 3
  },
  "output_directory": "data/evaluation/derived/runs"
}
